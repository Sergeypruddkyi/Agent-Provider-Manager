<Window x:Class="ClaudeProviderLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Agent Provider Manager"
        Icon="pack://application:,,,/icon.png"
        Width="720"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <!-- On Windows 11 the window is opaque and DWM draws the rounded outer shape;
         on older systems the window stays transparent so the corner areas stay
         see-through. SizeChanged clips children (e.g. the close button hover)
         to the rounded outline. -->
    <Border x:Name="RootBorder"
            BorderBrush="#3F3F46" BorderThickness="1" Background="#1E1E1E"
            CornerRadius="8"
            SizeChanged="RootBorder_SizeChanged">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom TitleBar Row matching DarkTitleBar -->
                <RowDefinition Height="36"/>
                <!-- Main Content Row -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom TitleBar matching YouTubeDownloader DarkTitleBar -->
            <Grid Grid.Row="0" Background="#1E1E1E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon + Title text, matching DarkTitleBar.OnPaint layout -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Image Source="pack://application:,,,/icon.png"
                           Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="Agent Provider Manager"
                               Foreground="#E1E1E1"
                               FontSize="13"
                               FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window Control Buttons (Minimize and Close only) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize"/>
                    <Button Content="&#xE8BB;"
                            Style="{StaticResource TitleBarCloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1" Margin="16,12,16,8">
                <StackPanel>

                    <!-- Tool selection: always visible. Before a choice the settings
                         area stays collapsed and empty. -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tool" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ClaudeToolButton"
                                    AutomationProperties.AutomationId="ClaudeToolButton"
                                    Content="Claude Code" Height="28" Padding="14,0"
                                    Click="ClaudeToolButton_Click"/>
                            <Button x:Name="CodexToolButton"
                                    AutomationProperties.AutomationId="CodexToolButton"
                                    Content="Codex" Height="28" Padding="14,0" Margin="6,0,0,0"
                                    Click="CodexToolButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- CLI Detection Status (shown when no tool is selected, then updated per tool) -->
                    <StackPanel x:Name="CliStatusPanel" Margin="0,4,0,1" Orientation="Horizontal">
                        <TextBlock x:Name="ClaudeCliStatusText"
                                   AutomationProperties.AutomationId="ClaudeCliStatusText"
                                   Foreground="#9A9A9A" FontSize="12" Margin="0,0,16,0"/>
                        <TextBlock x:Name="CodexCliStatusText"
                                   AutomationProperties.AutomationId="CodexCliStatusText"
                                   Foreground="#9A9A9A" FontSize="12" Margin="0,0,16,0"/>
                    </StackPanel>

                    <TextBlock x:Name="ToolHintText"
                               AutomationProperties.AutomationId="ToolHintText"
                               Text="Select a tool to configure and launch."
                               Foreground="#9A9A9A" Margin="0,0,0,1"/>

                    <StackPanel x:Name="SettingsPanel"
                                AutomationProperties.AutomationId="SettingsPanel"
                                Visibility="Collapsed">

                        <Border Height="1" Background="#3F3F46" Margin="0,6,0,6"/>

                        <TextBlock x:Name="ActiveProfileText"
                                   AutomationProperties.AutomationId="ActiveProfileText"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>

                        <TextBlock x:Name="ProfileHintText"
                                   AutomationProperties.AutomationId="ProfileHintText"
                                   Foreground="#9A9A9A" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <!-- Profile (system default + user presets of the selected tool) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Profile" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="26"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ProfileNameBox"
                                             AutomationProperties.AutomationId="ProfileNameBox"
                                             Height="30"
                                             TextChanged="ProfileNameBox_TextChanged"/>
                                    <Button x:Name="ProfileDropdownButton"
                                            Grid.Column="1"
                                            AutomationProperties.AutomationId="ProfileDropdownButton"
                                            Content="▼"
                                            Width="26"
                                            Height="30"
                                            Margin="2,0,0,0"
                                            Padding="0"
                                            Click="ProfileDropdownButton_Click"/>
                                    <Popup x:Name="ProfileDropdownPopup"
                                           StaysOpen="False"
                                           Placement="Bottom"
                                           PopupAnimation="Slide"
                                           PlacementTarget="{Binding ElementName=ProfileDropdownButton}"
                                           Closed="ProfileDropdownPopup_Closed">
                                        <Border Background="{StaticResource BrushInput}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                SnapsToDevicePixels="True"
                                                Margin="0,2,0,0">
                                            <ItemsControl x:Name="ProfileDropdownList"
                                                          AutomationProperties.AutomationId="ProfileDropdownList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border x:Name="ItemBorder"
                                                                Padding="8,6"
                                                                MouseDown="ProfileDropdownItem_Click"
                                                                SnapsToDevicePixels="True">
                                                            <TextBlock x:Name="ItemText"
                                                                        Text="{Binding DisplayName}"
                                                                        Foreground="{StaticResource BrushTextLight}"
                                                                        FontSize="13"
                                                                        VerticalAlignment="Center"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <Button Grid.Column="1" x:Name="SavePresetButton"
                                        AutomationProperties.AutomationId="SavePresetButton"
                                        Content="Save Preset" Margin="8,0,0,0" Padding="10,0" Height="30"
                                        Click="SavePresetButton_Click"/>
                                <Button Grid.Column="2" x:Name="NewButton"
                                        AutomationProperties.AutomationId="NewButton"
                                        Content="New" Margin="6,0,0,0" Padding="10,0" Height="30"
                                        Click="NewButton_Click"/>
                                <Button Grid.Column="3" x:Name="DeletePresetButton"
                                        AutomationProperties.AutomationId="DeletePresetButton"
                                        Content="Delete" Margin="6,0,0,0" Padding="10,0" Height="30"
                                        IsEnabled="False"
                                        Click="DeletePresetButton_Click"/>
                            </Grid>
                        </Grid>

                        <Grid x:Name="BaseUrlRow" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Base URL" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="BaseUrlBox"
                                     AutomationProperties.AutomationId="BaseUrlBox" Height="30"/>
                        </Grid>

                        <Grid x:Name="ApiKeyRow" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="API Key / Auth Token" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Column="1" x:Name="ApiKeyBox"
                                         AutomationProperties.AutomationId="ApiKeyBox" Height="30"/>
                        </Grid>

                        <Grid x:Name="ModelRow" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Model" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="ModelBox"
                                     AutomationProperties.AutomationId="ModelBox" Height="30"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Working Directory" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="WorkingDirBox"
                                     AutomationProperties.AutomationId="WorkingDirBox" Height="30"/>
                            <Button Grid.Column="2" x:Name="BrowseButton"
                                    AutomationProperties.AutomationId="BrowseButton"
                                    Content="Browse..." Margin="8,0,0,0" Padding="14,0" Height="30"
                                    Click="BrowseButton_Click"/>
                        </Grid>

                        <Button Grid.Column="0" Grid.ColumnSpan="2" x:Name="StartButton"
                                AutomationProperties.AutomationId="StartButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="START" Height="40" Margin="0,16,0,0" IsEnabled="False"
                                Click="StartButton_Click"/>

                        <!-- Restores the original settings of the selected tool. Claude Code
                             restores ~/.claude/settings.json; Codex restores ~/.codex/config.toml. -->
                        <Button x:Name="RestoreDefaultsButton"
                                AutomationProperties.AutomationId="RestoreDefaultsButton"
                                Content="Restore Original Settings" Height="30" Margin="0,8,0,0"
                                Click="RestoreDefaultsButton_Click"/>

                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               AutomationProperties.AutomationId="StatusText"
                               Margin="0,8,0,0" VerticalAlignment="Top"
                               TextWrapping="Wrap" Foreground="#9A9A9A"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
